# Copy to .env (never commit .env). All settings are optional for local use.

# Where data is stored. Local default is a SQLite file in ./data.
# Hosted: a PostgreSQL URL from your provider (postgres:// or postgresql:// both work).
DATABASE_URL=sqlite:///data/ndwatch.db

# Password for the Reviewer page in the dashboard (leave empty to hide that page).
NDWATCH_ADMIN_PASSWORD=

# Polite crawling
NDWATCH_REQUEST_INTERVAL=1.5        # seconds between requests to ndlegis.gov
NDWATCH_MAX_PDFS_PER_RUN=1000       # bill-text PDFs read per run (backfill happens gradually)
NDWATCH_MAX_TESTIMONY_PAGES_PER_RUN=60

# Which assemblies to monitor: the newest N, plus any listed here (e.g. 69-2025 for history).
NDWATCH_ASSEMBLIES_TO_TRACK=1
NDWATCH_EXTRA_ASSEMBLIES=

# How often a full check happens, in minutes, by period.
NDWATCH_POLL_ACTIVE_MIN=60
NDWATCH_POLL_PREFILING_MIN=120
NDWATCH_POLL_OFFSEASON_MIN=720

# Show a "may be out of date" warning when the last successful check is older than this.
NDWATCH_STALE_AFTER_MINUTES=180
